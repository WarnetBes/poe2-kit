{
  "name": "@poe2-kit/web",
  "version": "1.0.22",
  "private": true,
  "type": "module",
  "description": "Веб-приложение PoE2 Kit: прайс-чек, курсы валют, гид по прокачке, AI-чат, импорт билда",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:deploy": "tsc -p tsconfig.json && vite build --outDir deploy-dist --base ./",
    "preview": "vite preview"
  },
  "dependencies": {
    "@poe2-kit/core": "*",
    "@poe2-toolkit/tree-core": "^1.0.0",
    "@poe2-toolkit/tree-react": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
