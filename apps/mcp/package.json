{
  "name": "@poe2-kit/mcp",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "MCP-сервер PoE2 Kit: инструменты poe2_* поверх единого ядра для ИИ-ассистентов (OpenCode и др.)",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "poe2-kit-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node dist/index.js --smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@poe2-kit/core": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
