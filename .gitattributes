# Пакетные файлы Windows обязаны иметь CRLF-переносы: cmd.exe некорректно
# исполняет .bat с LF (обрывки вида "'evel' is not recognized" на if errorlevel).
# Git при checkout/clone на Windows теперь всегда конвертирует их в CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# .hideout = game-native JSON+BOM, game writes LF (verified 12/12 live exports).
# -text: forbid EOL rewrite on checkout (core.autocrlf=true would CRLF-ify
# working copies and break byte-exact fixture/roundtrip comparisons).
*.hideout -text
