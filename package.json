{
  "name": "poe2-kit",
  "version": "1.0.8",
  "private": true,
  "description": "Бесплатный набор инструментов для Path of Exile 2: веб-приложение, Windows-оверлей и MCP-сервер на едином ядре",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/web",
    "apps/overlay",
    "apps/mcp"
  ],
  "scripts": {
    "build": "npm run build -w @poe2-kit/core",
    "web": "npm run dev -w @poe2-kit/web",
    "overlay": "npm run dev -w @poe2-kit/overlay",
    "mcp": "npm run start -w @poe2-kit/mcp",
    "test": "npm run test -w @poe2-kit/core",
    "live-smoke": "npm run build -w @poe2-kit/core && npm run live-smoke -w @poe2-kit/core",
    "portable": "node make-portable.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true,
    "koffi@3.3.1": true
  }
}
